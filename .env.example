# MMStore AI Social Media Growth Agent Environment Configuration
# Copy to .env in root or frontend/.env / functions/.env as instructed

# Firebase Client Configuration (Frontend)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=mmstore-growth.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mmstore-growth
VITE_FIREBASE_STORAGE_BUCKET=mmstore-growth.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_USE_FIREBASE_EMULATOR=true

# AI Provider Keys
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Social Platform API Credentials (Functions & Server-side only)
# Meta Graph API (Instagram & Facebook)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=your_secure_verify_token

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# YouTube Data API v3 (Google Cloud OAuth)
YOUTUBE_CLIENT_ID=your_google_client_id
YOUTUBE_CLIENT_SECRET=your_google_client_secret

# Pinterest API v5
PINTEREST_APP_ID=your_pinterest_app_id
PINTEREST_APP_SECRET=your_pinterest_app_secret

# X (Twitter) Developer API v2
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_BEARER_TOKEN=your_x_bearer_token

# Telegram Bot API
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# WhatsApp Cloud API (Meta Business)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token

# Brand & E-Commerce Defaults
DEFAULT_CURRENCY=EGP
DEFAULT_TIMEZONE=Africa/Cairo
DEFAULT_STORE_URL=https://mmstore.com
AUTOPILOT_DAILY_POST_LIMIT=10
AUTOPILOT_MAX_DAILY_AD_SPEND=500
