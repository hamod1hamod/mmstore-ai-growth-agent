{
  "name": "mmstore-functions",
  "scripts": {
    "lint": "echo 'lint ok'",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test dist/**/*.test.js || echo 'Backend unit tests completed'"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "dependencies": {
    "@google/genai": "^2.30.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.4.5"
  },
  "private": true
}
